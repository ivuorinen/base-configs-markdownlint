root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 160
tab_width = 2
trim_trailing_whitespace = true

[{*.md}]
indent_size = 2
tab_width = 2
max_line_length = 160
trim_trailing_whitespace = false

[{*.mk,GNUmakefile,makefile}]
tab_width = 4
indent_style = tab

# JSON Lines holds one record per line by definition, so a record cannot be
# wrapped. docs/audit/findings/resolved.jsonl is the findings ledger.
[*.jsonl]
max_line_length = off
